.sisyphus/
.nx/
node_modules/
.yarn/install-state.gz

# Per-package test bundles. They are rebuilt on demand by the
# `build-tests` Nx target before `:test` runs, so the esbuild path
# comment differs between local and CI builds. They must NOT be
# committed.
packages/*/dist-test/

.claude/worktrees
.worktrees/
.slim/deepwork/

# Local OpenCode transport probes. The probe scripts under
# `packages/run-reviews/probes/` and the captured evidence under
# `docs/probes/` are write-only developer artifacts that must
# NEVER land in a commit. They are regenerated by running the
# probe and contain model outputs, server logs, and redacted
# session state that depend on the developer's local auth.
packages/run-reviews/probes/
docs/probes/

