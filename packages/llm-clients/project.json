{
  "name": "llm-clients",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/llm-clients",
  "sourceRoot": "packages/llm-clients/src",
  "targets": {
    "build-tests": {
      "_comment": "dist-test/index.cjs is gitignored; rebuilt on demand before :test.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/llm-clients",
        "command": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-test/index.cjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-tests"],
      "options": {
        "cwd": "packages/llm-clients",
        "command": "node --test test/*.test.cjs"
      }
    }
  }
}
