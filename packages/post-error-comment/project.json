{
  "name": "post-error-comment",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/post-error-comment",
  "sourceRoot": "packages/post-error-comment/src",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "packages/post-error-comment/src/action.ts",
        "outputPath": "packages/post-error-comment/dist",
        "outputFileName": "main.cjs",
        "tsConfig": "packages/post-error-comment/tsconfig.json",
        "bundle": true,
        "platform": "node",
        "target": "node20",
        "format": ["cjs"],
        "thirdParty": true
      }
    },
    "build-tests": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/post-error-comment",
        "command": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-test/index.cjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-tests"],
      "options": {
        "cwd": "packages/post-error-comment",
        "command": "node --test test/*.test.cjs"
      }
    }
  }
}