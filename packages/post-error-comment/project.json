{
  "name": "post-error-comment",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/post-error-comment",
  "sourceRoot": "packages/post-error-comment/src",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "packages/post-error-comment/src/main.ts",
        "outputPath": "packages/post-error-comment/dist",
        "outputFileName": "main.cjs",
        "tsConfig": "packages/post-error-comment/tsconfig.json",
        "bundle": true,
        "platform": "node",
        "target": "node20",
        "format": ["cjs"],
        "thirdParty": true
      }
    }
  }
}
