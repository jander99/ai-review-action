{
  "name": "setup-opencode",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/setup-opencode",
  "sourceRoot": "packages/setup-opencode/src",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "packages/setup-opencode/src/action.ts",
        "outputPath": "packages/setup-opencode/dist",
        "outputFileName": "main.cjs",
        "tsConfig": "packages/setup-opencode/tsconfig.json",
        "bundle": true,
        "platform": "node",
        "target": "node20",
        "format": ["cjs"],
        "thirdParty": true
      }
    },
    "build-tests": {
      "_comment": "packages/setup-opencode/dist-test/index.cjs is gitignored (see /.gitignore). It is rebuilt on demand before :test runs. Keeping it out of git prevents esbuild's cwd-relative path comment from drifting between local and CI builds.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/setup-opencode",
        "command": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-test/index.cjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-tests"],
      "options": {
        "cwd": "packages/setup-opencode",
        "command": "node --test test/*.test.cjs"
      }
    }
  }
}