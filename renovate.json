{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "America/Chicago",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "dependencyDashboard": {
    "enabled": true
  },
  "vulnerabilityAlerts": { "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "Workspace-internal packages are not published to npm",
      "matchPackageNames": ["@jander99/ai-review-*"],
      "enabled": false
    },
    {
      "description": "Keep Nx packages moving together",
      "matchPackageNames": ["nx", "@nx/**"],
      "groupName": "nx"
    },
    {
      "description": "Provider SDKs need conformance suites re-run; never automerge",
      "matchPackageNames": ["@anthropic-ai/sdk", "openai", "@google/genai", "@typesafe-ai/sdk"],
      "groupName": "provider SDKs",
      "automerge": false
    },
    {
      "description": "Nx 24 cannot load TypeScript 7 (tsModule.readConfigFile is not a function); hold majors until Nx supports it",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
